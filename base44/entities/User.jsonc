{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "welcome_sent": {
      "type": "boolean",
      "title": "\u00bfCorreo de bienvenida enviado?",
      "default": false
    },
    "tyc_accepted": {
      "type": "boolean",
      "title": "\u00bfAcept\u00f3 T\u00e9rminos y Condiciones?",
      "default": false
    },
    "photo_url": {
      "type": "string",
      "title": "Foto de perfil (URL)"
    }
  },
  "required": [
    "role"
  ]
}